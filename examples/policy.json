{
  "version": 1,
  "repositories": {
    "owner/project": {
      "permissions": ["summarize", "classify", "rank", "triage", "mark-processed"],
      "labels": {
        "bug": "Reported malfunction with expected and observed behavior",
        "enhancement": "Request for additional behavior",
        "needs-info": "Missing reproduction or requirements"
      },
      "ranking": [
        {"score": 3, "meaning": "Evidence of a supported workflow being blocked"},
        {"score": 2, "meaning": "Actionable work with documented user impact"},
        {"score": 1, "meaning": "Useful request needing investigation"},
        {"score": 0, "meaning": "No current actionable work established"}
      ],
      "triage": {
        "inbox": "Needs a decision",
        "planned": "Concrete next action selected",
        "waiting": "Needs another person's input",
        "snoozed": "Explicitly deferred until a future timestamp",
        "done": "Requested local maintenance is complete"
      },
      "item_budget": 10,
      "refresh": false,
      "test_commands": []
    }
  }
}
